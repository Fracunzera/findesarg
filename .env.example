# --- Base de datos ---
POSTGRES_USER=quehacer
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=quehacer

# --- Web ---
# Nombre del sitio (provisorio). Se usa en el logo, los títulos y el pie.
SITIO_NOMBRE=Qué hacer
# Dónde escucha la web en el host. En el VPS dejalo en 127.0.0.1 y poné un reverse proxy adelante.
WEB_BIND=127.0.0.1
WEB_PORT=8000
# URL pública del sitio. Va en el User-Agent: tiene que ser real (Overpass rechaza example.com con 406).
SITIO_URL=https://github.com/Fracunzera/findesarg

# --- Ingesta ---
# Endpoints de Overpass separados por coma; se prueban en orden, con backoff exponencial.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Segundos mínimos entre requests al mismo dominio
SEGUNDOS_ENTRE_REQUESTS=5

# --- Extracción de eventos con LLM (fase 2) ---
# Sin key, la ingesta igual baja y prefiltra las notas; las que pasan quedan esperando.
ANTHROPIC_API_KEY=
LLM_MODELO=claude-haiku-5-5
# No procesar notas de hace más de N días, y como mucho N notas nuevas por fuente y corrida
DIAS_MAX_NOTA=14
MAX_ITEMS_POR_CORRIDA=25

# --- Panel /admin y formulario público ---
# Sin ADMIN_CLAVE el panel queda deshabilitado. Usá una clave larga.
ADMIN_USUARIO=admin
ADMIN_CLAVE=
# Firma las cookies de sesión y los formularios. Generalo con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRETO=
# Eventos que se pueden mandar desde el formulario por IP y por hora
MAX_ENVIOS_POR_HORA=5
